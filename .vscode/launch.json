{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BCI: conduzir experimento",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "BCI: testar pipeline simulada (sem Unity)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--smoke"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {"MPLBACKEND": "Agg"}
    }
  ]
}
